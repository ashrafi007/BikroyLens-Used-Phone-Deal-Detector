# Copy this file to .env and fill in your real values.
# .env is already in .gitignore — never commit real credentials.

# Get this from: Supabase Dashboard -> your project -> Settings -> Database
# -> "Connection string" -> URI tab. Use the "Session pooler" connection
# (port 6543) if available -- works better for short-lived script
# connections than the direct connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres
